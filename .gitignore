# Extension working copy (separate git repository)
/packages/*
!/packages/.gitkeep

# Per-instance build output
/instances/*/vendor/
/instances/*/var/
/instances/*/public/*
!/instances/*/public/typo3conf/
/instances/*/public/typo3conf/*
!/instances/*/public/typo3conf/AdditionalConfiguration.php
/instances/*/config/sites/
/instances/*/config/system/settings.php
/instances/*/composer.lock

# Generated DDEV configuration (active TYPO3 version)
/.ddev/config.zz-version.yaml

# Leftovers of the former single-instance setup (TYPO3 9-11)
/app/
/var/
/tmp/
/.build/
/.tests/

# Tooling caches
/.php-cs-fixer.cache
/.phpunit.result.cache

# Local editor / agent settings
/.idea/
**/.claude/settings.local.json
.DS_Store
