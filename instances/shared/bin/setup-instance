#!/usr/bin/env bash
# Install TYPO3 in the current instance directory (composer root) non-interactively.
# Usage (from an instance's composer.json): setup-instance <major-version>
# Runs inside the DDEV web container. Idempotent: an installed instance is left as is,
# only the extension setup (database schema) runs again.
# The database connection is always taken from TYPO3_INSTANCE_DB at runtime
# (see instances/shared/development.php), not from the generated settings file.

set -euo pipefail

major="${1:?TYPO3 major version required}"
db_name="${TYPO3_INSTANCE_DB:-t3_v${major}}"
admin_user="${TYPO3_ADMIN_USER:-admin}"
admin_password="${TYPO3_ADMIN_PASSWORD:-Password.1}"
site_url="${DDEV_PRIMARY_URL:-https://t3events-bundle.ddev.site}/"

mysql -h db -uroot -proot -e "CREATE DATABASE IF NOT EXISTS \`${db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"

if [ "${major}" -ge 12 ]; then
    settings_file="config/system/settings.php"
    cli="vendor/bin/typo3"
else
    # TYPO3 11 uses typo3-console 7 (binary typo3cms)
    settings_file="public/typo3conf/LocalConfiguration.php"
    cli="vendor/bin/typo3cms"
fi

# A failed setup can leave the settings file without database tables.
# Only an instance with backend users counts as installed.
if [ -f "${settings_file}" ] \
    && [ -z "$(mysql -h db -uroot -proot -N -e "SHOW TABLES LIKE 'be_users'" "${db_name}")" ]; then
    echo "TYPO3 ${major} is not installed completely (no table be_users), moving ${settings_file} to ${settings_file}.incomplete"
    mv "${settings_file}" "${settings_file}.incomplete"
fi

if [ -f "${settings_file}" ]; then
    echo "TYPO3 ${major} already installed (${settings_file} exists)."
elif [ "${major}" -ge 12 ]; then
    "${cli}" setup \
        --no-interaction \
        --force \
        --driver=mysqli \
        --host=db \
        --port=3306 \
        --dbname="${db_name}" \
        --username=root \
        --password=root \
        --admin-username="${admin_user}" \
        --admin-user-password="${admin_password}" \
        --admin-email=admin@example.com \
        --project-name="t3events TYPO3 ${major}" \
        --server-type=other \
        --create-site="${site_url}"
else
    "${cli}" install:setup \
        --no-interaction \
        --force \
        --database-driver=mysqli \
        --database-host-name=db \
        --database-port=3306 \
        --database-name="${db_name}" \
        --database-user-name=root \
        --database-user-password=root \
        --use-existing-database \
        --admin-user-name="${admin_user}" \
        --admin-password="${admin_password}" \
        --site-name="t3events TYPO3 ${major}" \
        --site-setup-type=site \
        --site-base-url="${site_url}" \
        --web-server-config=none
fi

# Readable URLs: import the route configuration of t3events (4.x and later) into the
# site configuration. Removed again if the checked out extension branch has no such file.
site_config="config/sites/main/config.yaml"
routes_file="/var/www/html/packages/t3events/Configuration/Routes/Default.yaml"
routes_marker="# t3events-bundle: route configuration of t3events (managed by setup-instance)"
if [ "${major}" -ge 13 ] && [ -f "${site_config}" ]; then
    if [ -f "${routes_file}" ]; then
        if grep -qF "${routes_marker}" "${site_config}"; then
            :
        elif grep -q '^imports:' "${site_config}"; then
            echo "${site_config} already has imports; add EXT:t3events/Configuration/Routes/Default.yaml manually."
        else
            {
                echo "${routes_marker}"
                echo "imports:"
                echo "  - { resource: 'EXT:t3events/Configuration/Routes/Default.yaml' }"
                cat "${site_config}"
            } > "${site_config}.tmp" && mv "${site_config}.tmp" "${site_config}"
            echo "Route configuration of t3events imported in ${site_config}"
        fi
    elif grep -qF "${routes_marker}" "${site_config}"; then
        # the marker is followed by the two lines of the import
        awk -v marker="${routes_marker}" 'skip > 0 { skip--; next } $0 == marker { skip = 2; next } { print }' \
            "${site_config}" > "${site_config}.tmp" && mv "${site_config}.tmp" "${site_config}"
        echo "Route configuration of t3events removed from ${site_config} (not in the checked out extension)"
    fi
fi

"${cli}" extension:setup
"${cli}" cache:flush

echo "Backend: ${site_url}typo3/ (user: ${admin_user}, password: ${admin_password})"
